import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // The original HTML has aem-GridColumn classes on the outer div.
  // Since the block itself is the outer div, we add them there.
  block.classList.add('spaceAdder', 'aem-GridColumn', 'aem-GridColumn--default--12');

  const spaceAdderDiv = document.createElement('div');
  spaceAdderDiv.classList.add('w-100', 'pt-3', 'pt-sm-3');
  // The original HTML shows an empty style attribute for background, so we replicate that.
  spaceAdderDiv.style.background = ''; 

  // moveInstrumentation is not needed here as we are creating a new element, not moving existing content.
  // The block is already the parent, so we just append the new div.
  block.append(spaceAdderDiv);
}

