import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // The block model is empty, so we just need to replicate the structure from the original HTML.
  // The original HTML had a div with specific classes and an empty style.
  const div = document.createElement('div');
  div.classList.add('w-100', 'pt-3', 'pt-sm-3');
  div.style.background = ''; // Replicate the empty background style from the original HTML.
  moveInstrumentation(block, div);
  block.append(div);
}
