import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const spaceDiv = document.createElement('div');
  spaceDiv.classList.add('w-100', 'pt-3', 'pt-sm-3');
  spaceDiv.style.background = ''; // No background property in original HTML, so leave empty or remove if not needed.
  moveInstrumentation(block, spaceDiv);
  block.append(spaceDiv);

  // The block has no fields, so no rows or cells to process.
  // The original HTML only contains a single div with specific classes and an empty style attribute.
  // The block itself will inherit the 'spaceAdder aem-GridColumn aem-GridColumn--default--12' classes
  // from the outer div in the original HTML, as per standard EDS behavior.
}
