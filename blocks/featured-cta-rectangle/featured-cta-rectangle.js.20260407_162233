import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [
    imageRow,
    imageAltRow,
    titleRow,
    textRow,
    primaryLinkRow,
    primaryLinkLabelRow,
    imageCreditRow,
  ] = [...block.children];

  block.textContent = '';

  const section = document.createElement('section');
  section.classList.add('theme-light', 'theme-bg', 'theme-section-spacing');
  section.setAttribute('data-testid', 'featured-cta-rectangle');

  const container = document.createElement('div');
  container.classList.add('container');

  const mainGrid = document.createElement('div');
  mainGrid.classList.add('grid', 'grid-full', 'md:gap-grid-gutter', 'justify-center', 'items-center');

  // Image content
  const imageWrapper = document.createElement('div');
  imageWrapper.classList.add('order-1', 'md:order-2', 'relative', 'md:col-start-8', 'md:col-span-8', 'xl:col-start-7', 'xl:col-span-7', 'lg:z-10', 'min-w-0', 'md:row-start-1', 'md:row-end-1');
  imageWrapper.setAttribute('data-testid', 'featured-cta-image');

  const imageAspectWrapper = document.createElement('div');
  imageAspectWrapper.classList.add('aspect-4/3', 'max-w-[672px]', 'w-full', 'mx-auto');

  const picture = imageRow.querySelector('picture');
  if (picture) {
    const img = picture.querySelector('img');
    if (img) {
      const altText = imageAltRow.textContent.trim();
      img.alt = altText;
      img.classList.add('rounded-t-sm', 'md:rounded-sm', 'overflow-hidden', 'w-full', 'h-auto');
      const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '672' }]);
      moveInstrumentation(img, optimizedPic.querySelector('img'));
      imageAspectWrapper.append(optimizedPic);
    }
  }
  imageWrapper.append(imageAspectWrapper);

  // Text content
  const textWrapper = document.createElement('div');
  textWrapper.classList.add('order-2', 'md:order-1', 'relative', 'md:col-span-8', 'md:col-start-1', 'xl:col-start-2', 'xl:col-span-6', 'md:z-20', 'bg-card-surface', 'theme-dark:bg-card-surface-td', 'theme-medium:bg-card-surface-tm', 'text-foreground', 'theme-dark:text-foreground-tm', 'theme-medium:text-foreground-td', 'rounded-sm', 'flex', 'flex-col', 'justify-center', 'space-y-2xs', 'p-6', 'xl:p-lg', 'md:row-start-1', 'md:row-end-1');

  const title = document.createElement('h4');
  title.classList.add('text-h4', 'font-bold');
  title.setAttribute('data-testid', 'featured-cta-title');
  moveInstrumentation(titleRow, title);
  while (titleRow.firstChild) title.append(titleRow.firstChild);

  const textDiv = document.createElement('div');
  textDiv.classList.add('prose', 'theme-dark:prose-tm', 'theme-medium:prose-td', 'max-w-none');
  textDiv.setAttribute('data-testid', 'featured-cta-text');
  moveInstrumentation(textRow, textDiv);
  while (textRow.firstChild) textDiv.append(textRow.firstChild);

  const linksDiv = document.createElement('div');
  linksDiv.classList.add('flex', 'flex-wrap', 'gap-xs', 'mt-6');
  linksDiv.setAttribute('data-testid', 'featured-cta-links');

  const primaryLink = document.createElement('a');
  primaryLink.classList.add('w-full', 'md:w-auto', 'button', 'button--dark', 'theme-medium:button--light');
  primaryLink.setAttribute('data-testid', 'featured-cta-link-primary');
  const primaryLinkHref = primaryLinkRow.querySelector('a')?.href || '#';
  primaryLink.href = primaryLinkHref;
  const primaryLinkLabel = primaryLinkLabelRow.textContent.trim();
  primaryLink.textContent = primaryLinkLabel;
  moveInstrumentation(primaryLinkRow, primaryLink);
  moveInstrumentation(primaryLinkLabelRow, primaryLink);
  linksDiv.append(primaryLink);

  textWrapper.append(title, textDiv, linksDiv);

  mainGrid.append(imageWrapper, textWrapper);
  container.append(mainGrid);

  // Image Credit
  const imageCreditGrid = document.createElement('div');
  imageCreditGrid.classList.add('grid-full', 'grid-centered-12');

  const imageCreditWrapper = document.createElement('div');
  imageCreditWrapper.classList.add('md:text-end', 'order-1', 'md:order-2', 'relative', 'md:col-start-8', 'md:col-span-8', 'xl:col-start-8', 'xl:col-span-6', 'lg:z-10', 'min-w-0', 'md:row-start-1', 'md:row-end-1');

  const imageCreditDiv = document.createElement('div');
  imageCreditDiv.classList.add('mt-2xs');

  const imageCreditP = document.createElement('p');
  imageCreditP.classList.add('z-1', 'relative', 'text-caption-size', 'theme-dark:text-foreground-colored-muted', 'text-foreground-muted');
  moveInstrumentation(imageCreditRow, imageCreditP);
  while (imageCreditRow.firstChild) imageCreditP.append(imageCreditRow.firstChild);

  imageCreditDiv.append(imageCreditP);
  imageCreditWrapper.append(imageCreditDiv);
  imageCreditGrid.append(imageCreditWrapper);
  container.append(imageCreditGrid);

  section.append(container);
  block.append(section);
}
