import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [headingRow, descriptionRow, ...cardRows] = [...block.children];

  // Create section-header
  const sectionHeader = document.createElement('div');
  sectionHeader.classList.add('section-header', 'text-center', 'pb-3');
  moveInstrumentation(headingRow, sectionHeader);

  // Heading
  const heading = document.createElement('h2');
  heading.classList.add('heading', 'font-regular', 'aos-init', 'aos-animate');
  // Use innerHTML to preserve potential <br> tags from original HTML
  heading.innerHTML = headingRow.firstElementChild.innerHTML;
  sectionHeader.appendChild(heading);

  // Description
  const description = document.createElement('p');
  description.classList.add('aos-init', 'aos-animate');
  // Use innerHTML to preserve potential HTML structure, though model says text
  description.innerHTML = descriptionRow.firstElementChild.innerHTML;
  sectionHeader.appendChild(description);

  // Create cards grid
  const cardsGrid = document.createElement('div');
  cardsGrid.classList.add('row', 'g-4', 'purpose-led-grid', 'pt-3');

  cardRows.forEach((row) => {
    // Destructuring is correct here as per BlockJson and EDS structure for purpose-led-card
    const [linkCell, imageCell, altTextCell, descriptionCell] = [...row.children];

    const col = document.createElement('div');
    col.classList.add('col-md-6', 'aos-init', 'aos-animate');
    moveInstrumentation(row, col);

    const cardWrap = document.createElement('a');
    cardWrap.classList.add('card-wrap');
    const foundLink = linkCell.querySelector('a');
    if (foundLink) {
      cardWrap.href = foundLink.href;
      cardWrap.target = '_blank'; // Add target="_blank" as per original HTML
    }

    const cardImage = document.createElement('div');
    cardImage.classList.add('card-image');

    const picture = imageCell.querySelector('picture');
    if (picture) {
      const img = picture.querySelector('img');
      if (img) {
        const altText = altTextCell.textContent.trim(); // Get alt text from its dedicated cell
        // createOptimizedPicture now correctly uses the altText from the model
        const optimizedPic = createOptimizedPicture(img.src, altText, false, [{ width: '750' }]);

        // Copy source elements from the original picture to the optimized one
        [...picture.children].forEach((child) => {
          if (child.tagName === 'SOURCE') {
            optimizedPic.prepend(child.cloneNode(true));
          }
        });

        // Ensure img-fluid class is added to the img inside the optimized picture
        const optimizedImg = optimizedPic.querySelector('img');
        if (optimizedImg) {
          optimizedImg.classList.add('img-fluid');
          moveInstrumentation(img, optimizedImg); // Move instrumentation from original img to new img
        }
        cardImage.appendChild(optimizedPic);
      }
    }

    const cardText = document.createElement('div');
    cardText.classList.add('card-text');

    const desc = document.createElement('p');
    desc.classList.add('desc');
    desc.innerHTML = descriptionCell.innerHTML; // Use innerHTML for richtext as per model

    cardText.appendChild(desc);
    cardWrap.appendChild(cardImage);
    cardWrap.appendChild(cardText);
    col.appendChild(cardWrap);
    cardsGrid.appendChild(col);
  });

  const container = document.createElement('div');
  container.classList.add('container');
  container.appendChild(sectionHeader);
  container.appendChild(cardsGrid);

  block.innerHTML = '';
  block.classList.add('section', 'grey-bg', 'spirit-of-rise');
  block.appendChild(container);
}
