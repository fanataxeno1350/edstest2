import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // Separate section rows from card rows based on content
  const allRows = [...block.children];
  const sectionRows = [];
  const cardRows = [];

  allRows.forEach(row => {
    // A section row has 3 cells, and the third cell contains "Cards value" text,
    // and it does not contain a picture (as cards do).
    // The BlockJson indicates the third cell is a container for cards,
    // but the actual content is just "Cards value" text.
    const cells = [...row.children];
    if (cells.length === 3 && cells[2].textContent.trim() === 'Cards value' && !row.querySelector('picture')) {
      sectionRows.push(row);
    } else if (cells.length === 3 && row.querySelector('picture')) {
      // A card row has 3 cells and contains a picture
      cardRows.push(row);
    }
  });

  const sectionsContainer = document.createElement('div');
  moveInstrumentation(block, sectionsContainer);

  let currentCardIndex = 0; // To keep track of which cards belong to which section

  sectionRows.forEach((row, sectionIndex) => {
    const [headingCell, descriptionCell] = [...row.children]; // Destructuring is safe here as per model

    const sectionElement = document.createElement('section');
    sectionElement.classList.add('section', 'spirit-of-rise');
    if (sectionIndex % 2 !== 0) {
      sectionElement.classList.add('grey-bg');
    }

    const sectionHeader = document.createElement('div');
    sectionHeader.classList.add('section-header', 'text-center', 'pb-3');

    const heading = document.createElement('h2');
    heading.classList.add('heading', 'font-regular', 'aos-init', 'aos-animate');
    heading.textContent = headingCell.textContent.trim();
    moveInstrumentation(headingCell, heading);

    const description = document.createElement('p');
    description.classList.add('aos-init', 'aos-animate');
    description.textContent = descriptionCell.textContent.trim();
    moveInstrumentation(descriptionCell, description);

    sectionHeader.append(heading, description);

    const performanceDriven = document.createElement('div');
    performanceDriven.classList.add('performance-driven', 'performace-driven-home');

    const container = document.createElement('div');
    container.classList.add('container');

    const cardsWrapper = document.createElement('div');
    cardsWrapper.classList.add('performace-driven-cards');

    // Each section is followed by 3 cards.
    // We need to associate the correct cards with the current section.
    const cardsForSection = cardRows.slice(currentCardIndex, currentCardIndex + 3);
    currentCardIndex += 3; // Move to the next set of cards for the next section

    cardsForSection.forEach((cardRow) => {
      const [imageCell, linkCell, descriptionCell] = [...cardRow.children]; // Destructuring is safe here as per model

      const link = document.createElement('a');
      link.classList.add('performace-driven-cards-link');
      const foundLink = linkCell.querySelector('a');
      if (foundLink) {
        link.href = foundLink.href;
      }
      moveInstrumentation(linkCell, link);

      const cardWrapper = document.createElement('div');
      cardWrapper.classList.add('performace-driven-card-wrapper');

      const cardImage = document.createElement('div');
      cardImage.classList.add('card-image');
      const picture = imageCell.querySelector('picture');
      if (picture) {
        const img = picture.querySelector('img');
        if (img) {
          const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
          moveInstrumentation(img, optimizedPic.querySelector('img'));
          cardImage.append(optimizedPic);
        }
      }
      moveInstrumentation(imageCell, cardImage);

      const boxCard = document.createElement('div');
      boxCard.classList.add('performace-driven-home-box-card');

      const desc = document.createElement('p');
      desc.classList.add('desc');
      // Use innerHTML for description as it might contain <br> tags from original HTML
      desc.innerHTML = descriptionCell.textContent.trim().replace(/\n/g, '<br>');
      moveInstrumentation(descriptionCell, desc);

      boxCard.append(desc);
      cardWrapper.append(cardImage, boxCard);
      link.append(cardWrapper);
      cardsWrapper.append(link);
    });

    container.append(cardsWrapper);
    performanceDriven.append(container);
    sectionElement.append(sectionHeader, performanceDriven);
    sectionsContainer.append(sectionElement);
  });

  block.replaceWith(sectionsContainer);
}
