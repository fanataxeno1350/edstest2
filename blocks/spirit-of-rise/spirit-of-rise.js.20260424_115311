import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // Identify section rows (3 cells, no picture) and card rows (3 cells, with picture)
  const allRows = [...block.children];
  const sectionRows = allRows.filter((row) => {
    const cells = [...row.children];
    return cells.length === 3 && !cells.some(cell => cell.querySelector('picture'));
  });
  const cardRows = allRows.filter((row) => {
    const cells = [...row.children];
    return cells.length === 3 && cells.some(cell => cell.querySelector('picture'));
  });

  const sections = [];

  // Group cards by section
  sectionRows.forEach((sectionRow) => {
    const cells = [...sectionRow.children];
    const headingCell = cells.find(cell => !cell.querySelector('picture') && !cell.querySelector('a') && cell.textContent.trim() !== 'Cards value');
    const descriptionCell = cells.find(cell => cell !== headingCell && !cell.querySelector('picture') && !cell.querySelector('a') && cell.textContent.trim() !== 'Cards value');

    sections.push({
      heading: headingCell ? headingCell.textContent.trim() : '',
      description: descriptionCell ? descriptionCell.textContent.trim() : '',
      cards: [],
    });
    moveInstrumentation(sectionRow, sections[sections.length - 1]);
  });

  // Assign cards to sections based on their order in the block
  let sectionIndex = 0;
  let cardsInSectionCount = 0;
  cardRows.forEach((cardRow) => {
    // Assuming 3 cards per section based on original HTML structure
    if (cardsInSectionCount >= 3 && sectionIndex < sections.length - 1) {
      sectionIndex++;
      cardsInSectionCount = 0;
    }
    if (sections[sectionIndex]) {
      sections[sectionIndex].cards.push(cardRow);
      cardsInSectionCount++;
    }
  });

  block.innerHTML = ''; // Clear the block content

  sections.forEach((sectionData, index) => {
    const sectionEl = document.createElement('section');
    sectionEl.classList.add('section', 'spirit-of-rise');
    if (index % 2 !== 0) { // Apply grey-bg to alternate sections
      sectionEl.classList.add('grey-bg');
    }

    const sectionHeader = document.createElement('div');
    sectionHeader.classList.add('section-header', 'text-center', 'pb-3');

    const heading = document.createElement('h2');
    heading.classList.add('heading', 'font-regular', 'aos-init', 'aos-animate');
    heading.textContent = sectionData.heading;
    sectionHeader.append(heading);

    const description = document.createElement('p');
    description.classList.add('aos-init', 'aos-animate');
    description.textContent = sectionData.description;
    sectionHeader.append(description);

    sectionEl.append(sectionHeader);

    const performanceDriven = document.createElement('div');
    performanceDriven.classList.add('performance-driven', 'performace-driven-home');

    const container = document.createElement('div');
    container.classList.add('container');

    const cardsWrapper = document.createElement('div');
    cardsWrapper.classList.add('performace-driven-cards');

    sectionData.cards.forEach((cardRow) => {
      const cells = [...cardRow.children];
      const imageCell = cells.find(cell => cell.querySelector('picture'));
      const linkCell = cells.find(cell => cell.querySelector('a'));
      const descriptionCell = cells.find(cell => cell !== imageCell && cell !== linkCell);

      const linkEl = document.createElement('a');
      linkEl.classList.add('performace-driven-cards-link');
      const foundLink = linkCell ? linkCell.querySelector('a') : null;
      if (foundLink) {
        linkEl.href = foundLink.href;
        linkEl.target = '_blank'; // Assuming target blank from original HTML
      }
      moveInstrumentation(cardRow, linkEl);

      const cardWrapper = document.createElement('div');
      cardWrapper.classList.add('performace-driven-card-wrapper');

      const cardImage = document.createElement('div');
      cardImage.classList.add('card-image');
      const picture = imageCell ? imageCell.querySelector('picture') : null;
      if (picture) {
        const img = picture.querySelector('img');
        if (img) {
          const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '576' }, { width: '750' }]);
          moveInstrumentation(img, optimizedPic.querySelector('img'));
          cardImage.append(optimizedPic);
        }
      }
      cardWrapper.append(cardImage);

      const homeBoxCard = document.createElement('div');
      homeBoxCard.classList.add('performace-driven-home-box-card');

      const desc = document.createElement('p');
      desc.classList.add('desc');
      desc.innerHTML = descriptionCell ? descriptionCell.textContent.trim() : ''; // Use innerHTML to preserve line breaks if any
      homeBoxCard.append(desc);

      cardWrapper.append(homeBoxCard);
      linkEl.append(cardWrapper);
      cardsWrapper.append(linkEl);
    });

    container.append(cardsWrapper);
    performanceDriven.append(container);
    sectionEl.append(performanceDriven);
    block.append(sectionEl);
  });
}
