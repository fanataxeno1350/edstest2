import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [headingRow, subheadingRow, ...purposeCardRows] = [...block.children];

  const containerDiv = document.createElement('div');
  containerDiv.classList.add('container');

  // Section Header
  const sectionHeader = document.createElement('div');
  sectionHeader.classList.add('section-header', 'text-center', 'pb-3');

  const heading = document.createElement('h2');
  heading.classList.add('heading', 'font-regular');
  moveInstrumentation(headingRow, heading);
  // Use innerHTML for heading to preserve <br> tags if authored, as per original HTML
  heading.innerHTML = headingRow.innerHTML.trim();
  sectionHeader.append(heading);

  const subheading = document.createElement('p');
  moveInstrumentation(subheadingRow, subheading);
  subheading.textContent = subheadingRow.textContent.trim();
  sectionHeader.append(subheading);

  containerDiv.append(sectionHeader);

  // Purpose Led Grid
  const purposeLedGrid = document.createElement('div');
  purposeLedGrid.classList.add('row', 'g-4', 'purpose-led-grid', 'pt-3');

  purposeCardRows.forEach((row) => {
    const [linkCell, imageMobileCell, imageDesktopCell, imageAltCell, descriptionCell] = [
      ...row.children,
    ];

    const colDiv = document.createElement('div');
    colDiv.classList.add('col-md-6');

    const cardLink = document.createElement('a');
    cardLink.classList.add('card-wrap');
    const foundLink = linkCell.querySelector('a');
    if (foundLink) {
      cardLink.href = foundLink.href;
      cardLink.target = '_blank'; // From original HTML
    }
    moveInstrumentation(row, cardLink);

    const cardImageDiv = document.createElement('div');
    cardImageDiv.classList.add('card-image');

    const picture = document.createElement('picture');
    const mobileImg = imageMobileCell.querySelector('img');
    const desktopImg = imageDesktopCell.querySelector('img');
    const altText = imageAltCell.textContent.trim();

    // Create sources for responsive images
    if (mobileImg) {
      const source = document.createElement('source');
      source.media = '(max-width: 576px)';
      source.srcset = mobileImg.src;
      picture.append(source);
    }

    let mainImgSrc = '';
    if (desktopImg) {
      mainImgSrc = desktopImg.src;
    } else if (mobileImg) { // Fallback to mobile if desktop is missing
      mainImgSrc = mobileImg.src;
    }

    if (mainImgSrc) {
      const img = document.createElement('img');
      img.src = mainImgSrc;
      img.classList.add('img-fluid');
      img.alt = altText;
      picture.append(img);
    }

    cardImageDiv.append(picture);
    cardLink.append(cardImageDiv);

    const cardTextDiv = document.createElement('div');
    cardTextDiv.classList.add('card-text');

    const descriptionP = document.createElement('p');
    descriptionP.classList.add('desc');
    descriptionP.innerHTML = descriptionCell.innerHTML;
    cardTextDiv.append(descriptionP);

    cardLink.append(cardTextDiv);
    colDiv.append(cardLink);
    purposeLedGrid.append(colDiv);
  });

  containerDiv.append(purposeLedGrid);

  block.replaceChildren(containerDiv);

  // Optimize images
  block.querySelectorAll('picture > img').forEach((img) => {
    // Ensure createOptimizedPicture uses the correct alt text from the img element
    const optimizedPic = createOptimizedPicture(img.src, img.alt, false, [{ width: '750' }]);
    // moveInstrumentation should be called on the original img element's parent (picture)
    // and the new picture element, or on the img and the new img.
    // For simplicity and to avoid issues with replaceWith, we can move instrumentation
    // to the new picture element itself if the original img's parent was instrumented.
    // However, the current setup moves it to the new img, which is acceptable.
    moveInstrumentation(img, optimizedPic.querySelector('img'));
    img.closest('picture').replaceWith(optimizedPic);
  });
}
