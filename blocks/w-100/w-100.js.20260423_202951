export default function decorate(block) {
  block.classList.add('pt-3', 'pt-sm-3');
  // The block has no content according to the EDS Block Structure and Block JSON.
  // Therefore, there's no need to iterate over children or set styles based on content.
  // The original HTML had an empty style attribute, which is not necessary to replicate
  // if it doesn't serve any functional purpose or override.
}
