import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  // Check 0 & 1: Structure Alignment - The block has only one row for the heading.
  // The BlockJson confirms a single 'heading' field.
  const rows = [...block.children];
  const headingRow = rows[0]; // This is acceptable as there's only one root row and it's explicitly the heading.

  const section = document.createElement('section');
  section.classList.add('theme-light', 'theme-bg', 'theme-section-spacing', 'first:not-is-themed:mt-component');

  const container = document.createElement('div');
  container.classList.add('container');

  const gridFull = document.createElement('div');
  gridFull.classList.add('grid-full');

  const gridCentered = document.createElement('div');
  gridCentered.classList.add('grid-centered-12', 'grid', 'grid-cols-subgrid', 'gap-grid-gutter');

  const colSpanDiv = document.createElement('div');
  colSpanDiv.classList.add('sm:col-span-14', 'md:col-span-12', 'xl:col-span-10');

  const h2 = document.createElement('h2');
  h2.classList.add('text-h2', 'theme-dark:text-foreground-td', 'theme-medium:text-foreground-tm', 'text-foreground', 'text-pretty');

  // Check 0: CRITICAL: .children[n] INDEX ACCESS - Original code used headingRow.querySelector('div')
  // which is fine for a single cell row. However, to be robust, we can explicitly get the first cell.
  // Given the EDS block structure, headingRow has one child which is the cell containing the heading.
  const headingCell = headingRow.children[0]; // This is acceptable as per the EDS structure, the first row has only one cell.
  if (headingCell) {
    moveInstrumentation(headingRow, h2);
    // Move all child nodes from the headingCell to the h2 element
    while (headingCell.firstChild) {
      h2.append(headingCell.firstChild);
    }
  }

  colSpanDiv.append(h2);
  gridCentered.append(colSpanDiv);
  gridFull.append(gridCentered);
  container.append(gridFull);
  section.append(container);

  block.textContent = '';
  block.append(section);

  // Check 2: Interactivity - No interactive elements found in the original HTML.
  // Check 3: Class Names - All class names are copied verbatim from the original HTML.
}
