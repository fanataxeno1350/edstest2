function transformNestedLists(rootUl) {
  rootUl.querySelectorAll('li').forEach((li) => {
    const nested = li.querySelector(':scope > ul');
    const anchor = li.querySelector(':scope > a');

    if (!anchor) {
      const textNode = [...li.childNodes].find(
        (n) => n.nodeType === Node.TEXT_NODE && n.textContent.trim(),
      );
      if (textNode) {
        const span = document.createElement('span');
        span.textContent = textNode.textContent.trim();
        textNode.remove();
        li.prepend(span);
      }
    }

    if (nested) {
      nested.remove();
      const subWrap = document.createElement('div');
      subWrap.classList.add('has-sub-child');
      subWrap.append(nested);
      li.append(subWrap);

      const trigger = li.querySelector(':scope > a, :scope > span');
      if (trigger) {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          li.classList.toggle('active');
          subWrap.classList.toggle('active');
        });
      }
      transformNestedLists(nested);
    }
  });
}

async function initSearch(block) {
  const searchToggle = block.querySelector('.search');
  const searchScreenWrap = block.querySelector('.search-screen-wrap');
  const searchInput = block.querySelector('#searchInput');
  const searchForm = block.querySelector('#search-block-form');
  const searchResultBox = block.querySelector('.searchResultBox');

  if (!searchToggle || !searchScreenWrap || !searchInput || !searchForm || !searchResultBox) {
    return;
  }

  const toggleSearch = (open) => {
    if (open) {
      searchScreenWrap.classList.add('active');
      searchToggle.classList.add('active');
      searchInput.focus();
    } else {
      searchScreenWrap.classList.remove('active');
      searchToggle.classList.remove('active');
      searchResultBox.style.display = 'none';
      searchInput.value = '';
    }
  };

  searchToggle.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    toggleSearch(!searchToggle.classList.contains('active'));
  });

  searchScreenWrap.addEventListener('click', (e) => {
    if (e.target === searchScreenWrap) {
      toggleSearch(false);
    }
  });

  // Handle search input interaction
  searchInput.addEventListener('input', () => {
    if (searchInput.value.trim().length > 0) {
      searchResultBox.style.display = 'block';
    } else {
      searchResultBox.style.display = 'none';
    }
  });

  // Swiper initialization for search results
  const swiperEl = block.querySelector('.searchResultBox .swiper');
  if (swiperEl) {
    await loadCSS('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css');
    await loadScript('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js');
    // eslint-disable-next-line no-undef
    new Swiper(swiperEl, {
      slidesPerView: 'auto',
      spaceBetween: 16,
      loop: false,
      scrollbar: {
        el: '.swiper-scrollbar',
        hide: true,
      },
    });
  }
}

