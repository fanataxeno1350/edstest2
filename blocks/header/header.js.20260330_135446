import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const headerWrapper = document.createElement('div');
  headerWrapper.classList.add('header-wrapper');

  const headerContent = document.createElement('div');
  headerContent.classList.add('header-content');

  // Hamburger checkbox
  const hamburgerCheckbox = block.querySelector('.experiencefragment-cmp-header__hamburger');
  if (hamburgerCheckbox) {
    moveInstrumentation(hamburgerCheckbox, headerContent);
    headerContent.append(hamburgerCheckbox);
  }

  // Logo
  const logoWrapper = document.createElement('div');
  logoWrapper.classList.add('logo');
  const logoLink = block.querySelector('.experiencefragment-cmp-header__logo a');
  const logoImg = block.querySelector('.experiencefragment-cmp-header__logo img');

  if (logoLink && logoImg) {
    const picture = createOptimizedPicture(logoImg.src, logoImg.alt);
    const newLogoLink = document.createElement('a');
    newLogoLink.href = logoLink.href;
    newLogoLink.append(picture);
    logoWrapper.append(newLogoLink);
    moveInstrumentation(logoImg, picture.querySelector('img'));
    moveInstrumentation(logoLink, newLogoLink);
    headerContent.append(logoWrapper);
  }

  // Navigation
  const navLinksWrapper = document.createElement('div');
  navLinksWrapper.classList.add('nav-links');
  const nav = document.createElement('nav');
  nav.classList.add('nav');
  const navUl = document.createElement('ul');

  const navItems = block.querySelectorAll('[data-aue-model="navItem"]');
  navItems.forEach((itemNode) => {
    const li = document.createElement('li');
    const link = itemNode.querySelector('a');
    if (link) {
      const newLink = document.createElement('a');
      newLink.href = link.href;
      newLink.textContent = link.textContent;
      li.append(newLink);
      moveInstrumentation(link, newLink);
      navUl.append(li);
    }
    moveInstrumentation(itemNode, li);
  });
  nav.append(navUl);
  navLinksWrapper.append(nav);

  // Mobile list (policy links and social media)
  const mobileListDiv = document.createElement('div');
  mobileListDiv.classList.add('mobile-list');

  const policyUl = document.createElement('ul');
  policyUl.classList.add('policy');
  const policyLinks = block.querySelectorAll('[data-aue-model="policyLink"]');
  policyLinks.forEach((itemNode) => {
    const li = document.createElement('li');
    li.classList.add('policy-list');
    const link = itemNode.querySelector('a');
    if (link) {
      const newLink = document.createElement('a');
      newLink.href = link.href;
      newLink.textContent = link.textContent;
      newLink.target = '_blank'; // Policy links have target="_blank"
      li.append(newLink);
      moveInstrumentation(link, newLink);
      policyUl.append(li);
    }
    moveInstrumentation(itemNode, li);
  });
  if (policyLinks.length > 0) {
    mobileListDiv.append(policyUl);
  }

  const socialMediaDiv = document.createElement('div');
  socialMediaDiv.classList.add('social-media');
  const socialLinks = block.querySelectorAll('[data-aue-model="socialLink"]');
  socialLinks.forEach((itemNode) => {
    const link = itemNode.querySelector('a');
    if (link) {
      const newLink = document.createElement('a');
      newLink.href = link.href;
      newLink.target = '_blank';
      newLink.classList.add(`icon-${itemNode.dataset.aueProp.toLowerCase()}`); // Assuming data-aue-prop matches icon class
      socialMediaDiv.append(newLink);
      moveInstrumentation(link, newLink);
    }
    moveInstrumentation(itemNode, socialMediaDiv);
  });
  if (socialLinks.length > 0) {
    mobileListDiv.append(socialMediaDiv);
  }

  if (policyLinks.length > 0 || socialLinks.length > 0) {
    nav.append(mobileListDiv);
  }

  navLinksWrapper.append(nav);
  headerContent.append(navLinksWrapper);

  // Nav icons (Accessibility, Search, Login)
  const navIconsDiv = document.createElement('div');
  navIconsDiv.classList.add('nav-icons');

  const accessibilityDiv = document.createElement('div');
  accessibilityDiv.classList.add('accessibility', 'hide-icon');
  const accessibilityLink = document.createElement('a');
  accessibilityLink.href = '#';
  accessibilityLink.classList.add('icon-img');
  const accessibilityIcon = document.createElement('div');
  accessibilityIcon.classList.add('icon-accessibility');
  accessibilityLink.append(accessibilityIcon);
  accessibilityDiv.append(accessibilityLink);
  navIconsDiv.append(accessibilityDiv);

  const searchDiv = document.createElement('div');
  searchDiv.classList.add('search');
  const searchLink = document.createElement('a');
  searchLink.href = '#';
  searchLink.classList.add('icon-img');
  const searchIcon = document.createElement('div');
  searchIcon.classList.add('icon-search');
  const searchText = document.createElement('div');
  searchText.classList.add('icon-text');
  searchText.textContent = 'Search';
  searchLink.append(searchIcon, searchText);
  searchDiv.append(searchLink);
  navIconsDiv.append(searchDiv);

  const loginDiv = document.createElement('div');
  loginDiv.classList.add('login', 'hide-icon');
  const loginLink = document.createElement('a');
  loginLink.href = '#';
  loginLink.classList.add('icon-img');
  const loginIcon = document.createElement('div');
  loginIcon.classList.add('icon-profile');
  loginLink.append(loginIcon);
  loginDiv.append(loginLink);
  navIconsDiv.append(loginDiv);

  headerContent.append(navIconsDiv);

  headerWrapper.append(headerContent);

  block.textContent = '';
  block.append(headerWrapper);
  block.className = `${block.dataset.blockName} block`;
  block.dataset.blockStatus = 'loaded';
}
