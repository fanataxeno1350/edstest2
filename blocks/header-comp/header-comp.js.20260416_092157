          } else {
            li.classList.add('no-child');
            // If no nested UL, it's a simple link.
            // The original HTML shows `header-comp__wrapper--menu-link` and `header-comp__wrapper--sub-menu-link`
            // for these as well, but without `dropdown-toggle`.
            const linkWrapper = document.createElement('div');
            linkWrapper.classList.add('header-comp__wrapper--menu-link', 'mb-3', 'mb-lg-0', 'gap-4', 'position-relative', 'w-100', 'd-flex', 'align-items-center', 'nav-link', 'px-0', 'font-18', 'leading-24', 'text-header-list', 'text-lg-black');

            const subMenuLinkContent = document.createElement('div');
            subMenuLinkContent.classList.add('header-comp__wrapper--sub-menu-link', 'dropdown-item', 'p-lg-3', 'mb-lg-3', 'mb-xl-3', 'leading-lg-24', 'leading-xl-24', 'font-default', 'font-lg-18', 'leading-lg-26', 'leading-28', 'ps-0', 'p-0', 'p-lg-3', 'd-inline-block', 'd-lg-flex', 'justify-content-between', 'align-items-center');

