              }
            }
            linkWrapper.appendChild(subMenuLinkContent);
            while (li.firstChild) {
              li.firstChild.remove();
            }
            li.appendChild(linkWrapper);
          }
        });

        // Replace the original rootUl with the processed tempDiv content
        while (rootUl.firstChild) {
