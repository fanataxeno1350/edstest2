        // We should focus on `header-comp__wrapper--sub-menu-group`, `header-comp__wrapper--sub-menu-item`, `child-below`, `no-child`.

        // Create a temporary div to parse the HTML and then apply classes
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = rootUl.innerHTML; // Use innerHTML to preserve nested structure
        moveInstrumentation(rootUl, tempDiv); // Move instrumentation from original UL to tempDiv

        tempDiv.querySelectorAll('ul').forEach((ul) => {
