          const subLiWrapper = document.createElement('li');
          subLiWrapper.classList.add('header-comp__wrapper--sub-menu-item', 'child-below');
          subMenuTriParent.append(subLiWrapper);

          const subMenuLinkDiv = document.createElement('div');
          subMenuLinkDiv.classList.add('header-comp__wrapper--menu-link', 'mb-3', 'mb-lg-0', 'gap-4', 'position-relative', 'w-100', 'd-flex', 'align-items-center', 'nav-link', 'px-0', 'font-18', 'leading-24', 'text-header-list', 'text-lg-black');
          subMenuLinkDiv.setAttribute('aria-current', 'page');
          subLiWrapper.append(subMenuLinkDiv);

          const subMenuLinkInnerDiv = document.createElement('div');
          subMenuLinkInnerDiv.classList.add('header-comp__wrapper--sub-menu-link', 'dropdown-item', 'p-lg-3', 'mb-lg-3', 'mb-xl-3', 'leading-lg-24', 'leading-xl-24', 'font-default', 'font-lg-18', 'leading-lg-26', 'leading-28', 'ps-0', 'p-0', 'p-lg-3', 'd-inline-block', 'd-lg-flex', 'justify-content-between', 'align-items-center');
          subMenuLinkDiv.append(subMenuLinkInnerDiv);

          const subSpan = subLi.querySelector(':scope > span');
