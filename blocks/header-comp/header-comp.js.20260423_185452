            subMenuLinkInnerDiv.append(arrowIconRight);

            const arrowIconMobile = document.createElement('span');
            arrowIconMobile.classList.add('arrow-icon', 'd-lg-none', 'end-0'); // Removed redundant d-lg-none
            arrowIconMobile.innerHTML = `
