import { createOptimizedPicture } from '../../scripts/aem.js';
import { moveInstrumentation } from '../../scripts/scripts.js';

export default function decorate(block) {
  const [headingRow, titleRow, ...itemRows] = [...block.children];

  const rangeComponent = document.createElement('div');
  rangeComponent.classList.add('range-component');

  // Heading
  const headerRow = document.createElement('div');
  headerRow.classList.add('row');
  const headerCol = document.createElement('div');
  headerCol.classList.add('col-md12', 'col-sm-12', 'col-md-12', 'gallery-header');
  const headingP = document.createElement('p');
  const strong = document.createElement('strong');
  moveInstrumentation(headingRow.firstElementChild, strong);
  strong.append(...headingRow.firstElementChild.children);
  headingP.append(strong);
  headerCol.append(headingP);
  headerRow.append(headerCol);
  rangeComponent.append(headerRow);

  // Title
  const sliderTitle = document.createElement('div');
  sliderTitle.classList.add('slider-title');
  const titleH4 = document.createElement('h4');
  moveInstrumentation(titleRow.firstElementChild, titleH4);
  titleH4.append(...titleRow.firstElementChild.children);
  // Assuming title will be used as ID
  titleH4.id = titleH4.textContent.toLowerCase().replace(/\s/g, '-');
  sliderTitle.append(titleH4);
  rangeComponent.append(sliderTitle);

  // Carousel for Desktop
  const desktopCarousel = document.createElement('div');
  desktopCarousel.id = `range-slider-${titleH4.id}-desktop`;
  desktopCarousel.classList.add('carousel', 'slide', 'd-none', 'd-sm-block');
  desktopCarousel.setAttribute('data-ride', 'carousel');

  const desktopCarouselInner = document.createElement('div');
  desktopCarouselInner.classList.add('carousel-inner');
  desktopCarousel.append(desktopCarouselInner);

  // Carousel for Mobile
  const mobileCarousel = document.createElement('div');
  mobileCarousel.id = `range-slider-${titleH4.id}-mobile`;
  mobileCarousel.classList.add('carousel', 'slide', 'd-sm-none');
  mobileCarousel.setAttribute('data-ride', 'carousel');

  const mobileCarouselInner = document.createElement('div');
  mobileCarouselInner.classList.add('carousel-inner');
  mobileCarousel.append(mobileCarouselInner);

  const slidesPerDesktop = 4;
  const slidesPerMobile = 2;

  let desktopItemIndex = 0;
  let mobileItemIndex = 0;

  while (desktopItemIndex < itemRows.length || mobileItemIndex < itemRows.length) {
    // Desktop carousel item
    if (desktopItemIndex < itemRows.length) {
      const desktopCarouselItem = document.createElement('div');
      desktopCarouselItem.classList.add('carousel-item');
      if (desktopItemIndex === 0) {
        desktopCarouselItem.classList.add('active');
      }
      const desktopItemRow = document.createElement('div');
      desktopItemRow.classList.add('row');
      desktopCarouselItem.append(desktopItemRow);

      for (let i = 0; i < slidesPerDesktop && (desktopItemIndex + i) < itemRows.length; i += 1) {
        const itemRow = itemRows[desktopItemIndex + i];
        const [imageCell, altCell, titleCell, linkCell] = [...itemRow.children];

        const col = document.createElement('div');
        col.classList.add('col-6', 'col-sm-6', 'col-lg-3');

        const linkEl = document.createElement('a');
        linkEl.classList.add('image-area');
        const foundLink = linkCell.querySelector('a');
        if (foundLink) {
          linkEl.href = foundLink.href;
        }
        moveInstrumentation(linkCell, linkEl);
        linkCell.remove(); // Remove original link cell content

        const imageContainer = document.createElement('div');
        imageContainer.classList.add('image-container');
        const picture = imageCell.querySelector('picture');
        if (picture) {
          const img = picture.querySelector('img');
          const optimizedPic = createOptimizedPicture(img.src, altCell.textContent.trim(), false, [{ width: '750' }]);
          moveInstrumentation(img, optimizedPic.querySelector('img'));
          imageContainer.append(optimizedPic);
        }
        linkEl.append(imageContainer);

        const imgTitle = document.createElement('h6');
        imgTitle.classList.add('img-title');
        moveInstrumentation(titleCell, imgTitle);
        imgTitle.append(...titleCell.children);
        linkEl.append(imgTitle);

        col.append(linkEl);
        desktopItemRow.append(col);
      }
      desktopCarouselInner.append(desktopCarouselItem);
      desktopItemIndex += slidesPerDesktop;
    }

    // Mobile carousel item
    if (mobileItemIndex < itemRows.length) {
      const mobileCarouselItem = document.createElement('div');
      mobileCarouselItem.classList.add('carousel-item');
      if (mobileItemIndex === 0) {
        mobileCarouselItem.classList.add('active');
      }
      const mobileItemRow = document.createElement('div');
      mobileItemRow.classList.add('row');
      mobileCarouselItem.append(mobileItemRow);

      for (let i = 0; i < slidesPerMobile && (mobileItemIndex + i) < itemRows.length; i += 1) {
        const itemRow = itemRows[mobileItemIndex + i];
        const [imageCell, altCell, titleCell, linkCell] = [...itemRow.children];

        const col = document.createElement('div');
        col.classList.add('col-6', 'col-sm-6', 'col-lg-3');

        const linkEl = document.createElement('a');
        linkEl.classList.add('image-area');
        const foundLink = linkCell.querySelector('a');
        if (foundLink) {
          linkEl.href = foundLink.href;
        }
        // Instrumentation for linkCell is already moved for desktop, so we create new link for mobile
        // and copy content. No need to moveInstrumentation again from original cell.
        // If linkCell was not consumed, we would move it.
        const originalLinkContent = foundLink ? foundLink.textContent : '';
        linkEl.textContent = originalLinkContent;

        const imageContainer = document.createElement('div');
        imageContainer.classList.add('image-container');
        const picture = imageCell.querySelector('picture');
        if (picture) {
          const img = picture.querySelector('img');
          const optimizedPic = createOptimizedPicture(img.src, altCell.textContent.trim(), false, [{ width: '750' }]);
          // Instrumentation for img is already moved for desktop, so we create new image for mobile
          // and copy content. No need to moveInstrumentation again from original cell.
          imageContainer.append(optimizedPic);
        }
        linkEl.prepend(imageContainer);

        const imgTitle = document.createElement('h6');
        imgTitle.classList.add('img-title');
        // Instrumentation for titleCell is already moved for desktop, so we create new title for mobile
        // and copy content. No need to moveInstrumentation again from original cell.
        imgTitle.textContent = titleCell.textContent.trim();
        linkEl.append(imgTitle);

        col.append(linkEl);
        mobileItemRow.append(col);
      }
      mobileCarouselInner.append(mobileCarouselItem);
      mobileItemIndex += slidesPerMobile;
    }
  }

  // Add controls for desktop carousel
  if (itemRows.length > slidesPerDesktop) {
    const prevButtonDesktop = document.createElement('a');
    prevButtonDesktop.classList.add('carousel-control-prev');
    prevButtonDesktop.href = `#${desktopCarousel.id}`;
    prevButtonDesktop.setAttribute('role', 'button');
    const prevIconDesktop = document.createElement('span');
    prevIconDesktop.classList.add('carousel-control-prev-icon');
    prevIconDesktop.setAttribute('aria-hidden', 'true');
    const prevTextDesktop = document.createElement('span');
    prevTextDesktop.classList.add('sr-only');
    prevTextDesktop.textContent = 'previous';
    prevButtonDesktop.append(prevIconDesktop, prevTextDesktop);
    desktopCarousel.append(prevButtonDesktop);

    const nextButtonDesktop = document.createElement('a');
    nextButtonDesktop.classList.add('carousel-control-next');
    nextButtonDesktop.href = `#${desktopCarousel.id}`;
    nextButtonDesktop.setAttribute('role', 'button');
    const nextIconDesktop = document.createElement('span');
    nextIconDesktop.classList.add('carousel-control-next-icon');
    nextIconDesktop.setAttribute('aria-hidden', 'true');
    const nextTextDesktop = document.createElement('span');
    nextTextDesktop.classList.add('sr-only');
    nextTextDesktop.textContent = 'next';
    nextButtonDesktop.append(nextIconDesktop, nextTextDesktop);
    desktopCarousel.append(nextButtonDesktop);

    // Add event listeners for desktop carousel controls
    prevButtonDesktop.addEventListener('click', (e) => {
      e.preventDefault();
      const activeItem = desktopCarouselInner.querySelector('.carousel-item.active');
      const prevItem = activeItem.previousElementSibling || desktopCarouselInner.lastElementChild;
      activeItem.classList.remove('active');
      prevItem.classList.add('active');
    });

    nextButtonDesktop.addEventListener('click', (e) => {
      e.preventDefault();
      const activeItem = desktopCarouselInner.querySelector('.carousel-item.active');
      const nextItem = activeItem.nextElementSibling || desktopCarouselInner.firstElementChild;
      activeItem.classList.remove('active');
      nextItem.classList.add('active');
    });
  }

  // Add controls for mobile carousel
  if (itemRows.length > slidesPerMobile) {
    const prevButtonMobile = document.createElement('a');
    prevButtonMobile.classList.add('carousel-control-prev');
    prevButtonMobile.href = `#${mobileCarousel.id}`;
    prevButtonMobile.setAttribute('role', 'button');
    const prevIconMobile = document.createElement('span');
    prevIconMobile.classList.add('carousel-control-prev-icon');
    prevIconMobile.setAttribute('aria-hidden', 'true');
    const prevTextMobile = document.createElement('span');
    prevTextMobile.classList.add('sr-only');
    prevTextMobile.textContent = 'previous';
    prevButtonMobile.append(prevIconMobile, prevTextMobile);
    mobileCarousel.append(prevButtonMobile);

    const nextButtonMobile = document.createElement('a');
    nextButtonMobile.classList.add('carousel-control-next');
    nextButtonMobile.href = `#${mobileCarousel.id}`;
    nextButtonMobile.setAttribute('role', 'button');
    const nextIconMobile = document.createElement('span');
    nextIconMobile.classList.add('carousel-control-next-icon');
    nextIconMobile.setAttribute('aria-hidden', 'true');
    const nextTextMobile = document.createElement('span');
    nextTextMobile.classList.add('sr-only');
    nextTextMobile.textContent = 'next';
    nextButtonMobile.append(nextIconMobile, nextTextMobile);
    mobileCarousel.append(nextButtonMobile);

    // Add event listeners for mobile carousel controls
    prevButtonMobile.addEventListener('click', (e) => {
      e.preventDefault();
      const activeItem = mobileCarouselInner.querySelector('.carousel-item.active');
      const prevItem = activeItem.previousElementSibling || mobileCarouselInner.lastElementChild;
      activeItem.classList.remove('active');
      prevItem.classList.add('active');
    });

    nextButtonMobile.addEventListener('click', (e) => {
      e.preventDefault();
      const activeItem = mobileCarouselInner.querySelector('.carousel-item.active');
      const nextItem = activeItem.nextElementSibling || mobileCarouselInner.firstElementChild;
      activeItem.classList.remove('active');
      nextItem.classList.add('active');
    });
  }

  rangeComponent.append(desktopCarousel, mobileCarousel);

  block.textContent = '';
  block.append(rangeComponent);
}
